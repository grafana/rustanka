apiVersion: apps/v1
kind: Deployment
metadata:
  name: query-tee
  namespace: default
spec:
  replicas: 2
  selector:
    matchLabels:
      name: query-tee
  template:
    metadata:
      labels:
        name: query-tee
    spec:
      containers:
      - args:
        - -backend.endpoints=http://query-frontend-1.loki.svc.cluster.local:3100,http://query-frontend-2.loki.svc.cluster.local:3100,http://query-frontend-3.loki.svc.cluster.local:3100
        - -backend.preferred=http://query-frontend-1.loki.svc.cluster.local:3100
        - -proxy.compare-responses=true
        - -proxy.value-comparison-tolerance=0.001
        - -proxy.passthrough-non-registered-routes=true
        - -server.http-listen-port=8080
        - -server.grpc-listen-port=9095
        image: grafana/query-tee:latest
        name: query-tee
