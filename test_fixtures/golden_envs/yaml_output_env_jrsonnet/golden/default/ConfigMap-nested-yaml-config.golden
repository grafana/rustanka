apiVersion: v1
data:
  rules.json: |-
    {
        "enabled": true,
        "rules": [
            {
                "labels": {
                    "clientId": "$3",
                    "partition": "$5",
                    "topic": "$4"
                },
                "name": "test_rule_1",
                "nested_again": [
                    {
                        "a": "c"
                    },
                    {
                        "b": "d"
                    }
                ],
                "pattern": "server<type=metrics, listener=(.+), processor=(.+)><>(.+):"
            }
        ]
    }
  rules.json.minified: '{"enabled":true,"rules":[{"labels":{"clientId":"$3","partition":"$5","topic":"$4"},"name":"test_rule_1","nested_again":[{"a":"c"},{"b":"d"}],"pattern":"server<type=metrics,
    listener=(.+), processor=(.+)><>(.+):"}]}'
  rules.yml: |-
    enabled: true
    rules:
    - labels:
        clientId: $3
        partition: $5
        topic: $4
      name: test_rule_1
      nested_again:
      - a: c
      - b: d
      pattern: "server<type=metrics, listener=(.+), processor=(.+)><>(.+):"
  rules.yml.quoted: |-
    "enabled": true
    "rules":
    - "labels":
        "clientId": "$3"
        "partition": "$5"
        "topic": "$4"
      "name": "test_rule_1"
      "nested_again":
      - "a": "c"
      - "b": "d"
      "pattern": "server<type=metrics, listener=(.+), processor=(.+)><>(.+):"
  rules.yml.quoted.indented: |-
    "enabled": true
    "rules":
      - "labels":
          "clientId": "$3"
          "partition": "$5"
          "topic": "$4"
        "name": "test_rule_1"
        "nested_again":
          - "a": "c"
          - "b": "d"
        "pattern": "server<type=metrics, listener=(.+), processor=(.+)><>(.+):"
kind: ConfigMap
metadata:
  name: nested-yaml-config
  namespace: default
