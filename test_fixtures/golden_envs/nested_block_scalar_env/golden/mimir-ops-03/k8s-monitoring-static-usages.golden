              workload=~"arg2",
              workload_type!="replicaset",
              workload_type!="deployment",
              workload_type!="daemonset",
              workload_type!="statefulset"
            }
          )
    - |-
      max by (cluster, namespace, workload, workload_type, asserts_env, asserts_site) (
            # replicaset
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (kube_replicaset_status_ready_replicas{cluster=~".+", namespace=~".+", replicaset=~".+"})
            * on (cluster, namespace, replicaset) group_left (workload, workload_type)
            label_replace(label_replace(max by (cluster, namespace, replicaset) (kube_replicaset_owner{cluster=~".+", namespace=~".+", replicaset=~".+", owner_kind=~""}), "workload", "$1", "replicaset", "(.+)"), "workload_type", "replicaset", "", "")

            OR

            # deployment (kube_replicaset)
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (kube_replicaset_status_ready_replicas{cluster=~".+", namespace=~".+", replicaset=~".+"})
            * on (cluster, namespace, replicaset, asserts_env, asserts_site) group_left (workload, workload_type)
            label_replace(label_replace(max by (cluster, namespace, replicaset, owner_name) (kube_replicaset_owner{cluster=~"${cluster:pipe}", namespace=~".+", replicaset=~".+", owner_is_controller="true", owner_kind="Deployment", owner_name!=""}), "workload", "$1", "owner_name", "(.+)"), "workload_type", "deployment", "", "")

            OR

            # deployment (kube_deployment)
            label_replace(label_replace(max by (cluster, namespace, deployment, asserts_env, asserts_site) (kube_deployment_status_replicas_available{cluster=~".+", namespace=~".+", deployment=~".+"}), "workload", "$1", "deployment", "(.+)"), "workload_type", "deployment", "", "")

            OR

            # daemonset
            label_replace(label_replace(max by (cluster, namespace, daemonset, asserts_env, asserts_site) (kube_daemonset_status_number_ready{cluster=~".+", namespace=~".+", daemonset=~".+"}), "workload", "$1", "daemonset", "(.+)"), "workload_type", "daemonset", "", "")

            OR

            # statefulset
            label_replace(label_replace(max by (cluster, namespace, statefulset, asserts_env, asserts_site) (kube_statefulset_status_replicas_ready{cluster=~".+", namespace=~".+", statefulset=~".+"}), "workload", "$1", "statefulset", "(.+)"), "workload_type", "statefulset", "", "")

            OR

            # everything else
            namespace_workload_pod:kube_pod_owner:relabel{
              cluster=~"${cluster:pipe}",
              namespace=~".+",
              workload=~".+",
              workload_type!="replicaset",
              workload_type!="deployment",
              workload_type!="daemonset",
              workload_type!="statefulset"
            }
          )
    - |-
      max by (cluster, namespace, workload, workload_type, asserts_env, asserts_site) (
            # replicaset
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (last_over_time((kube_replicaset_spec_replicas{cluster=~"${cluster:pipe}", namespace=~"arg1", replicaset=~"arg2"})[42m:]))
            * on (cluster, namespace, replicaset) group_left (workload, workload_type)
            label_replace(
                label_replace(
                    max by (cluster, namespace, replicaset) (last_over_time((kube_replicaset_owner{cluster=~"${cluster:pipe}", namespace=~"arg1", replicaset=~"arg2", owner_kind=""})[42m:]))
                    , "workload", "$1", "replicaset", "(.+)"
                )
                , "workload_type", "replicaset", "", ""
            )

            OR

            # deployment (kube_replicaset)
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (last_over_time((kube_replicaset_spec_replicas{cluster=~"${cluster:pipe}", namespace=~"arg1", replicaset=~"arg2"})[42m:]))
            * on (cluster, namespace, replicaset) group_left (workload, workload_type)
            label_replace(
                label_replace(
                    max by (cluster, namespace, replicaset, owner_name) (last_over_time((kube_replicaset_owner{cluster=~"${cluster:pipe}", namespace=~"arg1", replicaset=~"arg2", owner_is_controller="true", owner_kind="Deployment", owner_name!=""})[42m:]))
                    , "workload", "$1", "owner_name", "(.+)"
                )
                , "workload_type", "deployment", "", ""
            )

            OR

            # deployment (kube_deployment)
            label_replace(
              label_replace(
                  max by (cluster, namespace, deployment, asserts_env, asserts_site) (last_over_time((kube_deployment_spec_replicas{cluster=~"${cluster:pipe}", namespace=~"arg1", deployment=~"arg2"})[42m:]))
                  , "workload", "$1", "deployment", "(.+)"
              )
              , "workload_type", "deployment", "", ""
            )

            OR

            # daemonset
            label_replace(
                label_replace(
                    max by (cluster, namespace, daemonset, asserts_env, asserts_site) (last_over_time((kube_daemonset_status_desired_number_scheduled{cluster=~"${cluster:pipe}", namespace=~"arg1", daemonset=~"arg2"})[42m:]))
                    , "workload", "$1", "daemonset", "(.+)"
                )
            , "workload_type", "daemonset", "", ""
            )

            OR

            # statefulset
            label_replace(
                label_replace(
                    max by (cluster, namespace, statefulset, asserts_env, asserts_site) (last_over_time((kube_statefulset_replicas{cluster=~"${cluster:pipe}", namespace=~"arg1", statefulset=~"arg2"})[42m:]))
                    , "workload", "$1", "statefulset", "(.+)"
                )
            , "workload_type", "statefulset", "", ""
            )

            OR

            # everything else
            last_over_time((namespace_workload_pod:kube_pod_owner:relabel{
              cluster=~"${cluster:pipe}",
              namespace=~"arg1",
              workload=~"arg2",
              workload_type!="replicaset",
              workload_type!="deployment",
              workload_type!="daemonset",
              workload_type!="statefulset"
            })[42m:])
          )
    - |-
      max by (cluster, namespace, workload, workload_type, asserts_env, asserts_site) (
            # replicaset
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (last_over_time((kube_replicaset_spec_replicas{cluster=~"${cluster:pipe}", namespace=~".+", replicaset=~".+"})[42m:]))
            * on (cluster, namespace, replicaset) group_left (workload, workload_type)
            label_replace(
                label_replace(
                    max by (cluster, namespace, replicaset) (last_over_time((kube_replicaset_owner{cluster=~"${cluster:pipe}", namespace=~".+", replicaset=~".+", owner_kind=""})[42m:]))
                    , "workload", "$1", "replicaset", "(.+)"
                )
                , "workload_type", "replicaset", "", ""
            )

            OR

            # deployment (kube_replicaset)
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (last_over_time((kube_replicaset_spec_replicas{cluster=~"${cluster:pipe}", namespace=~".+", replicaset=~".+"})[42m:]))
            * on (cluster, namespace, replicaset) group_left (workload, workload_type)
            label_replace(
                label_replace(
                    max by (cluster, namespace, replicaset, owner_name) (last_over_time((kube_replicaset_owner{cluster=~"${cluster:pipe}", namespace=~".+", replicaset=~".+", owner_is_controller="true", owner_kind="Deployment", owner_name!=""})[42m:]))
                    , "workload", "$1", "owner_name", "(.+)"
                )
                , "workload_type", "deployment", "", ""
            )

            OR

            # deployment (kube_deployment)
            label_replace(
              label_replace(
                  max by (cluster, namespace, deployment, asserts_env, asserts_site) (last_over_time((kube_deployment_spec_replicas{cluster=~"${cluster:pipe}", namespace=~".+", deployment=~".+"})[42m:]))
                  , "workload", "$1", "deployment", "(.+)"
              )
              , "workload_type", "deployment", "", ""
            )

            OR

            # daemonset
            label_replace(
                label_replace(
                    max by (cluster, namespace, daemonset, asserts_env, asserts_site) (last_over_time((kube_daemonset_status_desired_number_scheduled{cluster=~"${cluster:pipe}", namespace=~".+", daemonset=~".+"})[42m:]))
                    , "workload", "$1", "daemonset", "(.+)"
                )
            , "workload_type", "daemonset", "", ""
            )

            OR

            # statefulset
            label_replace(
                label_replace(
                    max by (cluster, namespace, statefulset, asserts_env, asserts_site) (last_over_time((kube_statefulset_replicas{cluster=~"${cluster:pipe}", namespace=~".+", statefulset=~".+"})[42m:]))
                    , "workload", "$1", "statefulset", "(.+)"
                )
            , "workload_type", "statefulset", "", ""
            )

            OR

            # everything else
            last_over_time((namespace_workload_pod:kube_pod_owner:relabel{
              cluster=~"${cluster:pipe}",
              namespace=~".+",
              workload=~".+",
              workload_type!="replicaset",
              workload_type!="deployment",
              workload_type!="daemonset",
              workload_type!="statefulset"
            })[42m:])
          )
    - |-
      sum by (cluster, namespace, workload, workload_type) (
            # pod alerts
            group by (cluster, namespace, pod) (ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~"arg1", pod=~"arg2-.+"})
            * on (cluster, namespace, pod) group_left (workload, workload_type)
            topk by (cluster, namespace, pod) (1, group by (cluster, namespace, workload, workload_type, pod) (namespace_workload_pod:kube_pod_owner:relabel{cluster=~"arg0", namespace=~"arg1", workload=~"arg2"}))

            # workload alerts
            OR

            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~"arg1", pod="", replicaset=~"arg2"}
                , "workload_type", "replicaset", "", ""
              )
              , "workload", "$1", "replicaset", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~"arg1", pod="", daemonset=~"arg2"}
                , "workload_type", "daemonset", "", ""
              )
              , "workload", "$1", "daemonset", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~"arg1", pod="", deployment=~"arg2"}
                , "workload_type", "deployment", "", ""
                )
              , "workload", "$1", "deployment", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~"arg1", pod="", statefulset=~"arg2"}
                , "workload_type", "statefulset", "", ""
                )
              , "workload", "$1", "statefulset", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~"arg1", pod="", job_name=~"arg2"}
                , "workload_type", "job", "", ""
                )
              , "workload", "$1", "job_name", "(.*)"
            )
          )
    - |-
      sum by (cluster, namespace, workload, workload_type) (
            # pod alerts
            group by (cluster, namespace, pod) (ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~".+", pod=~".+-.+"})
            * on (cluster, namespace, pod) group_left (workload, workload_type)
            topk by (cluster, namespace, pod) (1, group by (cluster, namespace, workload, workload_type, pod) (namespace_workload_pod:kube_pod_owner:relabel{cluster=~".+", namespace=~".+", workload=~".+"}))

            # workload alerts
            OR

            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~".+", pod="", replicaset=~".+"}
                , "workload_type", "replicaset", "", ""
              )
              , "workload", "$1", "replicaset", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~".+", pod="", daemonset=~".+"}
                , "workload_type", "daemonset", "", ""
              )
              , "workload", "$1", "daemonset", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~".+", pod="", deployment=~".+"}
                , "workload_type", "deployment", "", ""
                )
              , "workload", "$1", "deployment", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~".+", pod="", statefulset=~".+"}
                , "workload_type", "statefulset", "", ""
                )
              , "workload", "$1", "statefulset", "(.*)"
            )
            OR
            label_replace(
              label_replace(
                ALERTS{alertstate="firing", alertname=~"(Kube.*|CPUThrottlingHigh)", cluster=~"${cluster:pipe}", namespace=~".+", pod="", job_name=~".+"}
                , "workload_type", "job", "", ""
                )
              , "workload", "$1", "job_name", "(.*)"
            )
          )
