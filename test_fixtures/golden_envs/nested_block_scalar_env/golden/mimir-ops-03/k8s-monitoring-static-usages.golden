              * on (cluster, namespace, pod) group_left
              sum by (cluster, namespace, pod) (
                  sum_over_time(sum by (cluster, namespace, pod) (
                      # actual cost of cpu allocation and usage is the max of:
                      max by (cluster, namespace, node, pod) (
                          # cpu requests (in cores)
                          sum by (cluster, namespace, node, pod, resource) (kube_pod_container_resource_requests{cluster=~"${cluster:pipe}", namespace=~"arg1", container!="POD", container!="", pod=~"arg2-.+", resource="cpu"})
