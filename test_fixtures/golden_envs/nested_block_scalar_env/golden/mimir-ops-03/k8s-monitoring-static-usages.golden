apiVersion: v1
data:
  a: a
  b: b
  c: c
  queries.yaml: |
    - asserts:node:count
    - sum by (cluster) (asserts:node_memory_MemAvailable_bytes:sum{})
    - sum(kube_namespace_status_phase{asserts_env!=""} == 1) by (cluster, namespace, asserts_env, asserts_site)
    - sum(max by (cluster, namespace) (namespace_cpu:kube_pod_container_resource_requests:sum{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}"})) / sum(max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"}) / sum(max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"}) / sum(max by (cluster, namespace) (namespace_cpu:kube_pod_container_resource_requests:sum{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}"}))
    - sum(max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - sum(max by (cluster, namespace) (namespace_cpu:kube_pod_container_resource_limits:sum{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}"}))
    - sum(max by (cluster, namespace) (namespace_cpu:kube_pod_container_resource_requests:sum{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}"}))
    - sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"})
    - sum by (cluster, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"}) / on (cluster) group_left() sum by (cluster) (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - group by (cluster, node) (ALERTS{node!="", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh"})
    - sum by (cluster, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"}) / on (cluster, node) group_left() sum by (cluster, node) (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - max by (cluster, node, os_image) (kube_node_info{cluster=~"$cluster", node=~"${node:pipe}"})
    - count by (cluster, node) (ALERTS{node!="", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh"})
    - last_over_time((max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))[42m:])
    - quantile_over_time(0.95, sum by (cluster, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"})[42m:42s])
    - quantile_over_time(0.95, sum by (cluster, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"})[42m:42s]) / quantile_over_time(0.95, sum by (cluster, node) (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))[42m:42s])
    - sum by (cluster, namespace) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"})
    - group by (cluster, namespace) (ALERTS{namespace=~"${namespace:pipe}", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh", node=~"${node:pipe}"})
    - sum by (cluster, namespace) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"}) / on (cluster) group_left() sum by (cluster) (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - group by (cluster, namespace) (ALERTS{namespace=~"${namespace:pipe}", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh", node=~"${node:pipe}"})
    - sum by (namespace, cluster) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"}) / on (namespace, cluster) sum by (namespace, cluster) (namespace_cpu:kube_pod_container_resource_requests:sum{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}"})
    - group by (cluster, namespace) (ALERTS{namespace=~"${namespace:pipe}", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh", node=~"${node:pipe}"})
    - max by (cluster, namespace) (kube_namespace_status_phase{phase="Active", cluster=~"$cluster", namespace=~"${namespace:pipe}"} == 1)
    - count by (cluster, namespace) (ALERTS{namespace=~"${namespace:pipe}", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh", node=~"${node:pipe}"})
    - quantile_over_time(0.95, sum by (cluster, namespace) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"})[42m:42s])
    - quantile_over_time(0.95, sum by (cluster, namespace) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", node=~"${node:pipe}"})[42m:42s]) / quantile_over_time(0.95, sum by (cluster, namespace) (namespace_cpu:kube_pod_container_resource_requests:sum{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}"})[42m:42s])
    - sum by (cluster) (node_filesystem_size_bytes{mountpoint=~"/"})
    - sum by (cluster) (max by (cluster, node, resource) (kube_node_status_capacity{resource=~"memory"}))
    - 1985 + 1986
    - 1985 + 1986
    - (1986 + 1986) /2
    - (1986 + 1986) / 2
    - 1985 / 1986
    - 1985 / 1986
    - 1 - (1986 / 1986)
    - 1 - (1986 / 1986)
    - 1 - (1986 / 1986)
    - 1985 + (1986 * 1986)
    - 1985 + (1986 * 1986)
    - 1985 + (1986 * 1986)
    - |-
      sum(
            floor(
              max by (cluster, node) (
                kube_node_status_capacity{resource="cpu", cluster=~"(${cluster:pipe})"}
              )
              - on (cluster, node) group_left(pod) (
                sum by (cluster, node) (
                  cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~"(${cluster:pipe})"}
                )
              )
            )
            * on (cluster, node) group_left()
            max by (cluster, node) (node_cpu_hourly_cost{cluster=~"(${cluster:pipe})"})
          ) * 24 * 30
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})"}))
    - |-
      (
            count(
              max by (cluster, namespace, pod, persistentvolume, persistentvolumeclaim) (pod_pvc_allocation{cluster=~"(${cluster:pipe})", pod="unmounted-pvs"})
            )
            /
            count(
              max by (cluster, namespace, pod, persistentvolume, persistentvolumeclaim) (pod_pvc_allocation{cluster=~"(${cluster:pipe})", pod!=""})
            )
          )
          OR on () vector(0)
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})"}))
    - |-
      sum(
            floor(
              max by (cluster, node) (
                kube_node_status_capacity{resource="cpu", cluster=~"(${cluster:pipe})"}
              )
              - on (cluster, node) group_left(pod) (
                sum by (cluster, node) (
                  cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~"(${cluster:pipe})"}
                )
              )
            )
            * on (cluster, node) group_left()
            max by (cluster, node) (node_cpu_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"gce://.*"}))
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"gce://.*"})) / sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"gce://.*"} offset 42m)) - 1
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"gce://.*"})) * 24
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"aws://.*"}))
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"aws://.*"})) / sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"aws://.*"} offset 42m)) - 1
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"aws://.*"})) * 24
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"azure://.*"}))
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"azure://.*"})) / sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"azure://.*"} offset 42m)) - 1
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id=~"azure://.*"})) * 24
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id!~"(aws|azure|gce)://.*"}))
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id!~"(aws|azure|gce)://.*"})) / sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id!~"(aws|azure|gce)://.*"} offset 42m)) - 1
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})", provider_id!~"(aws|azure|gce)://.*"})) * 24
    - sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})"})) / sum(max by (cluster, node) (node_total_hourly_cost{cluster=~"(${cluster:pipe})"} offset 42m)) - 1
    - |-
      sum(
            sum by (cluster, node) (
              kube_node_status_capacity{resource="cpu", cluster=~"(${cluster:pipe})"}
            )
            * on (cluster, node) group_left
            max by (cluster, node) (node_cpu_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - |-
      sum(
            floor(
              avg by (cluster, node) (
                kube_node_status_capacity{resource="cpu", cluster=~"(${cluster:pipe})"}
              )
              - on (cluster, node) group_left() (
                sum by (cluster, node) (
                  cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~"(${cluster:pipe})"}
                )
              )
            )
            * on (cluster, node) group_left
            max by (cluster, node) (node_cpu_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - |-
      sum(
            sum by (cluster, node) (
              kube_node_status_capacity{resource="memory", cluster=~"(${cluster:pipe})"}
            )
            /1024/1024/1024
            * on (cluster, node) group_left
            max by (cluster, node) (node_ram_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - |-
      sum(
            (
              avg by (cluster, node) (
                kube_node_status_capacity{resource="memory", cluster=~"(${cluster:pipe})"}
              )
              - on (cluster, node) group_left() (
                sum by (cluster, node) (
                  cluster:namespace:pod_memory:active:kube_pod_container_resource_requests{cluster=~"(${cluster:pipe})"}
                )
              )
            )
            /1024/1024/1024
            * on (cluster, node) group_left
            max by (cluster, node) (node_ram_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - |-
      sum(
            sum by (cluster, namespace, persistentvolume) (
              pod_pvc_allocation{cluster=~"(${cluster:pipe})"}
            ) /1024/1024/1024
            * on (cluster, persistentvolume) group_left
            max by (cluster, persistentvolume, volumename) (pv_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - |-
      sum(
            sum by (cluster, namespace, persistentvolume) (
              pod_pvc_allocation{cluster=~"(${cluster:pipe})"}
              - on (cluster, namespace, persistentvolumeclaim) group_left()
              max without (node, instance) (
                kubelet_volume_stats_used_bytes{cluster=~"(${cluster:pipe})"}
              )
            ) /1024/1024/1024
            * on (cluster, persistentvolume) group_left
            max by (cluster, persistentvolume, volumename) (pv_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - sum(sum(rate(node_network_transmit_bytes_total{device="eth0", cluster=~"(${cluster:pipe})"}[60m])/1024/1024/1024) by (cluster) * on (cluster) sum(kubecost_network_internet_egress_cost{cluster=~"(${cluster:pipe})"} + kubecost_network_region_egress_cost{cluster=~"(${cluster:pipe})"} + kubecost_network_zone_egress_cost{cluster=~"(${cluster:pipe})"}) by (cluster))
    - |-
      sum(
            max by (cluster, node) (node_gpu_count{cluster=~"(${cluster:pipe})"})
            * on (cluster, node) group_left
            max by (cluster, node) (node_gpu_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - |-
      sum(
            max by (cluster, node) (node_gpu_count{cluster=~"(${cluster:pipe})"})
            - on (cluster, node) group_left() (
              sum by (cluster, node) (
                max by (cluster, node, namespace, pod, container) (container_gpu_allocation{cluster=~"(${cluster:pipe})"})
              )
            )
            * on (cluster, node) group_left
            max by (cluster, node) (node_gpu_hourly_cost{cluster=~"(${cluster:pipe})"})
          )
    - kube_node_info{cluster!=""}
    - sum by (cluster, node) (max by (cluster, namespace, pod, container, node) (cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"})) / sum by (cluster, node) (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - sum by () (max by (cluster, namespace, pod, container, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"})) / sum by () (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - sum by () (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - sum by () (max by (cluster, namespace, pod, container, node) (cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - sum by () (max by (cluster, namespace, pod, container, node) (cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"}))
    - sum by () (max by (cluster, namespace, pod, container, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"}))
    - sum by (cluster, namespace, pod, node) (max by (cluster, namespace, pod, container, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"})) * on (cluster, namespace, pod) group_left(workload, workload_type) group by (cluster, namespace, pod, workload, workload_type) (namespace_workload_pod:kube_pod_owner:relabel{cluster=~"${cluster:pipe}", pod=~"${podNames:pipe}"}) / on (cluster, node) group_left() sum by (cluster, node) (max by (cluster, node) (kube_node_status_capacity{cluster=~"${cluster:pipe}", node=~"${node:pipe}"}))
    - group by (cluster, namespace, pod) (ALERTS{namespace!="", pod=~"${podNames:pipe}", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh"}) * on (cluster, namespace, pod) group_left() group by (cluster, namespace, pod) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{container!="", cluster=~"${cluster:pipe}", node=~"${node:pipe}"})
    - label_join(max by (cluster, namespace, pod, node) (kube_pod_info{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"}) * on (cluster, namespace, pod) group_left(workload, workload_type) group by (cluster, namespace, pod, workload, workload_type) (namespace_workload_pod:kube_pod_owner:relabel{cluster=~"${cluster:pipe}", pod=~"${podNames:pipe}"}), "join_key", ".", "cluster", "namespace", "pod", "node")
    - label_join(count by (cluster, namespace, pod, node) (ALERTS{namespace!="", pod=~"${podNames:pipe}", cluster=~"${cluster:pipe}", alertstate=~"firing", alertname=~"Kube.*|CPUThrottlingHigh"}) * on (cluster, namespace, pod) group_left(node) group by (cluster, namespace, pod, node) (kube_pod_info{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"}), "join_key", ".", "cluster", "namespace", "pod", "node")
    - |-
      label_join(
            last_over_time((sum by (cluster, namespace, pod, node) (cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"}))[42m:])
          , "join_key", ".", "cluster", "namespace", "pod", "node")
    - label_join(quantile_over_time(0.95, sum by (cluster, namespace, pod, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{container!="", cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"})[42m:42s]), "join_key", ".", "cluster", "namespace", "pod", "node")
    - label_join(quantile_over_time(0.95, sum by (cluster, namespace, pod, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{container!="", cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"})[42m:42s]) / quantile_over_time(0.95, sum by (cluster, namespace, pod, node) (cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~"${cluster:pipe}", node=~"${node:pipe}", pod=~"${podNames:pipe}"})[42m:42s]), "join_key", ".", "cluster", "namespace", "pod", "node")
    - |-
      sum(kubelet_running_containers{cluster=~"$cluster"})
            or vector(0)
    - |-
      sum(
              sum by (cluster, instance) (
                kubelet_running_containers{cluster=~"$cluster"}
              )
              * on (cluster, instance) group_left (node)
              group by (cluster, instance, node) (
                kubelet_node_name{cluster=~"$cluster", node=~"$node"}
              )
            ) or vector(0)
    - |-
      count(
              kube_pod_container_info{cluster=~"$cluster", namespace=~"$namespace"}
            ) or vector(0)
    - |-
      count(
              kube_pod_container_info{cluster=~"$cluster", namespace=~"$namespace", pod=~"$workload.*"}
            ) or vector(0)
    - count(last_over_time((kube_node_info{cluster!=""})[42m:]))
    - |-
      last_over_time(
            group by (cluster) (kube_node_info{cluster!=""})
          [42m:])
    - sum by (asserts_env, asserts_site, cluster, provider_id) (last_over_time((sum by (asserts_env, asserts_site, cluster, node, provider_id) (label_replace(max by (asserts_env, asserts_site, cluster, container_runtime_version, internal_ip, kernel_version, kubelet_version, node, os_image, pod_cidr, provider_id, system_uuid) (kube_node_info{cluster=~"${cluster:pipe}"}), "provider_id", "$1", "provider_id", "([^:]+)://.*")))[42m:]))
    - last_over_time((sum by (cluster) (max by (asserts_env, asserts_site, cluster, container_runtime_version, internal_ip, kernel_version, kubelet_version, node, os_image, pod_cidr, provider_id, system_uuid) (kube_node_info{cluster=~"${cluster:pipe}"})))[42m:])
    - count(group by (cluster, node) (kube_pod_info{cluster=~"${filteredClusters:pipe}", namespace=~"${namespace:pipe}", node!=""}))
    - count(group by (cluster, namespace, pod) (kube_pod_info{cluster=~"${filteredClusters:pipe}", namespace=~"${namespace:pipe}", pod!=""}))
    - count(group by (cluster, namespace, pod, container) (kube_pod_container_info{cluster=~"${filteredClusters:pipe}", namespace=~"${namespace:pipe}", pod!="", container!="POD", container!=""}))
    - count(group by (cluster) (kube_pod_info{cluster=~"${filteredClusters:pipe}", namespace=~"${namespace:pipe}"}))
    - count(group by (cluster, namespace) (kube_namespace_status_phase{cluster=~"${filteredClusters:pipe}", namespace=~"${namespace:pipe}"}))
    - |-
      count(
          max by (cluster, namespace, workload, workload_type, asserts_env, asserts_site) (
            # replicaset
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (last_over_time((kube_replicaset_spec_replicas{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", replicaset=~".+"})[42m:]))
            * on (cluster, namespace, replicaset) group_left (workload, workload_type)
            label_replace(
                label_replace(
                    max by (cluster, namespace, replicaset) (last_over_time((kube_replicaset_owner{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", replicaset=~".+", owner_kind=""})[42m:]))
                    , "workload", "$1", "replicaset", "(.+)"
                )
                , "workload_type", "replicaset", "", ""
            )

            OR

            # deployment (kube_replicaset)
            max by (cluster, namespace, replicaset, asserts_env, asserts_site) (last_over_time((kube_replicaset_spec_replicas{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", replicaset=~".+"})[42m:]))
            * on (cluster, namespace, replicaset) group_left (workload, workload_type)
            label_replace(
                label_replace(
                    max by (cluster, namespace, replicaset, owner_name) (last_over_time((kube_replicaset_owner{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", replicaset=~".+", owner_is_controller="true", owner_kind="Deployment", owner_name!=""})[42m:]))
                    , "workload", "$1", "owner_name", "(.+)"
                )
                , "workload_type", "deployment", "", ""
            )

            OR

            # deployment (kube_deployment)
            label_replace(
              label_replace(
                  max by (cluster, namespace, deployment, asserts_env, asserts_site) (last_over_time((kube_deployment_spec_replicas{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", deployment=~".+"})[42m:]))
                  , "workload", "$1", "deployment", "(.+)"
              )
              , "workload_type", "deployment", "", ""
            )

            OR

            # daemonset
            label_replace(
                label_replace(
                    max by (cluster, namespace, daemonset, asserts_env, asserts_site) (last_over_time((kube_daemonset_status_desired_number_scheduled{cluster=~"${cluster:pipe}", namespace=~"${namespace:pipe}", daemonset=~".+"})[42m:]))
                    , "workload", "$1", "daemonset", "(.+)"
                )
            , "workload_type", "daemonset", "", ""
            )

            OR

            # statefulset
            label_replace(
                label_replace(
