              max_over_time(
                  sum by (cluster, namespace, pod) (max by (cluster, namespace, pod, container) (node_namespace_pod_container:container_memory_working_set_bytes{cluster=~"${cluster:pipe}", namespace=~".+", pod=~".+", container!="POD", container!=""}))
