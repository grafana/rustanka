                            )
                          )
                      )
                      # multiplied by the hourly cost per node where this pod is running
                      * on (cluster, node) group_left
                      max by (cluster, node) (node_cpu_hourly_cost{cluster=~"${cluster:pipe}"})
                  )[42m:1h])
                  +
                  sum_over_time(sum by (cluster, namespace, pod) (
                      # actual cost of memory allocation and usage is the max of:
                      max by (cluster, namespace, node, pod) (
                          # memory requests (in bytes)
                          sum by (cluster, node, pod, resource) (kube_pod_container_resource_requests{cluster=~"${cluster:pipe}", namespace=~"arg1", pod=~"arg2-.+", container!="POD", container!="", resource="memory"})
                          OR
                          # memory usage (in bytes)
                          sum by (cluster, namespace, node, pod) (
                            container_memory_working_set_bytes{cluster=~"${cluster:pipe}", namespace=~"arg1", node!="", pod=~"arg2-.+", container!="POD", container!=""}
