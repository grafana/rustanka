apiVersion: argoproj.io/v1alpha1
kind: Workflow
metadata:
  annotations:
    my-annotation: my-value
  labels:
    tanka.dev/environment: 9a5105fdb36891c81d9c8bfdb420748fde559b55ba753fa3
  name: patch-test-patch
  namespace: mimir-cd
spec:
  activeDeadlineSeconds: 172800
  arguments:
    parameters:
    - name: commit
      value: ""
    - name: commit_author
      value: ""
    - name: commit_link
      value: ""
    - name: dockertag
      value: ""
  entrypoint: main
  hooks:
    completion-message:
      arguments:
        parameters:
        - name: channel
          value: '#test-jduchesne'
        - name: color
          value: '#00ff00'
        - name: context
          value: ""
        - name: message
          value: ""
        - name: thread_send_also_to_channel
          value: "false"
        - name: thread_ts
          value: '{{workflow.outputs.parameters.thread_ts}}'
        - name: title
          value: |
            :done: Patch `test-patch` rolled out
            Please clean up the patch by moving the applied changes somewhere more permanent, then remove the patch from `patching.libsonnet` and each cell's `applied-patches.jsonnet`.
      expression: workflow.status == "Succeeded"
      templateRef:
        clusterScope: true
        name: slack-notify
        template: slack-notify
  imagePullSecrets:
  - name: gar
  onExit: exit-handler
  podGC:
    strategy: OnWorkflowCompletion
  templateDefaults:
    serviceAccountName: argo-workflow
  templates:
  - inputs:
      parameters:
      - name: releaseNumberDev
      - name: releaseNumberProd1
      - name: releaseNumberProd2
      - name: releaseNumberProd3
      - name: releaseNumberProd4
    name: release-dev-eu-west-2--mimir-dev-10
    outputs:
      parameters:
      - name: mergedAt
        valueFrom:
          expression: 'steps["create-deployment-prs-dev-eu-west-2--mimir-dev-10-wait-for-pr"].status
            == "Succeeded" ? jsonpath(steps["create-deployment-prs-dev-eu-west-2--mimir-dev-10-wait-for-pr"].outputs.parameters["commit-info"],
            "$.mergedAt") : string(sprig.now().Unix())'
    serviceAccountName: argo-workflow
    steps:
    - - arguments:
          parameters:
          - name: config
            value: |-
              {
                "destination_branch": "master",
                "git_author_email": "124795786+updater-for-argo-workflows[bot]@users.noreply.github.com",
                "git_author_name": "updater-for-argo-workflows[bot]",
                "git_committer_email": "124795786+updater-for-argo-workflows[bot]@users.noreply.github.com",
                "git_committer_name": "updater-for-argo-workflows[bot]",
                "pull_request_branch_prefix": "auto-merge/updater/apply-patch-test-patch-to-mimir-dev-10",
                "pull_request_enabled": true,
                "pull_request_existing_strategy": "replace",
                "pull_request_message": "This PR will apply the `test-patch` patch to the cell `mimir-dev-10`\n\n:robot: _Created automatically by https://argo-workflows.grafana.net/workflows/{{workflow.namespace}}/{{workflow.name}}_\n",
                "pull_request_team_reviewers": [

                ],
                "pull_request_title": "Apply patch `test-patch` to `mimir-dev-10`",
                "repo_name": "deployment_tools",
                "repo_owner": "grafana",
                "update_jsonnet_attribute_configs": [
                  {
                    "file_path": "ksonnet/environments/cortex/dev-eu-west-2.mimir-dev-10/applied-patches.jsonnet",
                    "jsonnet_key": "test-patch",
                    "jsonnet_value": "the value for this object is not used and exists only because of a limitation in the Updater tool",
                    "upsert": true
                  }
                ]
              }
        name: apply-patch-mimir-dev-10
        templateRef:
          clusterScope: true
          name: git-updater
          template: git-updater
    - - arguments:
          parameters:
          - name: pr_url
            value: '{{steps.apply-patch-mimir-dev-10.outputs.parameters.pr_url}}'
          - name: timeout
            value: 24h
        name: apply-patch-mimir-dev-10-wait-for-pr
        templateRef:
          clusterScope: true
          name: wait-for-github-pr
          template: wait-for-github-pr
        when: '"{{steps.apply-patch-mimir-dev-10.outputs.parameters.pr_url}}" != ""'
  - inputs:
      parameters:
      - name: releaseNumberDev
